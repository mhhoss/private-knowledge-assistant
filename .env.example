# Copy to .env and fill in. Never commit .env.

# --- LLM provider (OpenAI-compatible) ---
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Embedding provider ---
# Optional. Defaults to the LLM values above. Set these only when the LLM gateway does
# not serve embeddings (e.g. OpenRouter).
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# Must support English and Persian. Changing this invalidates an existing index.
EMBEDDING_MODEL=text-embedding-3-small

# --- Local storage ---
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base
DATA_DIR=./data

# --- Chunking: character counts, not tokens (initial defaults, not yet tuned) ---
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# --- Retrieval ---
RETRIEVAL_TOP_K=5
# Minimum similarity for a chunk to count as context. Below this, the answer is a
# refusal. Placeholder value - tune per embedding model.
RETRIEVAL_MIN_SCORE=0.35

# --- UI -> API ---
API_BASE_URL=http://127.0.0.1:8000
