# Copy to .env and fill in. Never commit .env.

# --- LLM provider (OpenAI-compatible) ---
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Embedding provider ---
# Shipped default: BAAI/bge-m3 served locally via Ollama (`ollama pull bge-m3`,
# `ollama serve`) — local-first, and the model every retrieval default below was
# measured against (see ARCHITECTURE.md open question 2). Requires Ollama running
# separately; see README's Quick start.
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# Must support English and Persian. Changing this invalidates an existing index (or is
# refused by the Models panel's live update if documents are already indexed).
EMBEDDING_MODEL=bge-m3
# Optional alternative: a hosted embedding provider (faster, but sends document text
# off-machine) — comment the three lines above and uncomment these instead:
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# How many chunks per embedding request, and how long to wait for one. Defaults are
# tuned for a slow (e.g. local CPU) backend — see docs/ARCHITECTURE.md's scale
# evaluation. Raise EMBEDDING_BATCH_SIZE for a fast/hosted provider.
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=120

# --- Local storage ---
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base
DATA_DIR=./data

# --- Chunking: character counts, not tokens. Measured against BAAI/bge-m3 on a small
# real English/Persian/mixed corpus (see ARCHITECTURE.md open question 2): retrieval
# correctness was stable across 256/512/1024, so these are kept as the defaults. ---
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# --- Retrieval ---
RETRIEVAL_TOP_K=5
# Minimum similarity for a chunk to count as context. Below this, the answer is a
# refusal. Measured against BAAI/bge-m3 (cosine distance) on the eval/ corpus (23
# queries, 6 docs, 2026-08-19): answerable queries scored >= 0.487, out-of-corpus
# queries scored <= 0.462 (see ARCHITECTURE.md open question 2) — 0.47 sits in that
# gap. Re-tune if the embedding model changes.
RETRIEVAL_MIN_SCORE=0.47

# --- UI -> API ---
API_BASE_URL=http://127.0.0.1:8000
